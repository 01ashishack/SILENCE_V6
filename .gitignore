# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
graphify-out/

# Large analyzer / scratch dumps (regenerated; not source) — also in .claudeignore
analyze_*.txt
analyze_output*.txt
extracted_raw_phase2.txt
scratch/

# Claude related
.claude/settings.local.json

# Supabase CLI local cache
supabase/.temp/

# Downloaded variable-font sources used to instance the bundled static weights
# (see tools/build_static_fonts.py). The generated statics live in
# assets/google_fonts/ and ARE committed; these large VF sources are not.
tools/_var_cache/

###############################################################################
# Secrets (NEVER COMMIT THESE)
###############################################################################

# Android signing
android/key.properties
android/*.jks
android/*.keystore
*.jks
*.keystore

# Environment files
.env
.env.*
!.env.example

# Firebase / Google credentials
google-services.json.backup
GoogleService-Info.plist.backup

# Service accounts
service-account*.json
firebase-adminsdk*.json

# Local secret overrides
secrets/
secret/
private/
credentials/

# Plain-text secret notes (keystore passwords, API keys, etc.)
PROJECT_SECRETS.md
PROJECT_SECRETS*.md
*.secrets.md