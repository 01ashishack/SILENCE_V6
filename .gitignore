**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
graphify-out/

# Large analyzer / scratch dumps (regenerated; not source) — also in .claudeignore
analyze_*.txt
analyze_output*.txt
extracted_raw_phase2.txt
scratch/

# Claude related
.claude/settings.local.json

# Supabase CLI local cache
supabase/.temp/

# Downloaded variable-font sources used to instance the bundled static weights
# (see tools/build_static_fonts.py). The generated statics live in
# assets/google_fonts/ and ARE committed; these large VF sources are not.
tools/_var_cache/
